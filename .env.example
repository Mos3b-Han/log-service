# PostgreSQL credentials used by docker-compose.yml.
# The service works with zero configuration; these defaults are applied
# when the variables are unset. Override only if you need to.

POSTGRES_USER=logs
POSTGRES_PASSWORD=logs
POSTGRES_DB=logs

# Optional API-key authentication. OFF by default: a plain
# `docker compose up` with none of these set is the unauthenticated
# core service. Set AUTH_ENABLED=true and provide LOADGEN_API_KEY to
# require `Authorization: Bearer <key>` on the three data endpoints.
# GET /health is always unauthenticated.
AUTH_ENABLED=false
LOADGEN_API_KEY=

# Write-path tuning (safe defaults; override only to experiment).
# BUFFER_MAX_ROWS        flush the COPY buffer once this many rows queue
# BUFFER_MAX_LATENCY_MS  flush at least this often even when below size
# BUFFER_MAX_PENDING_ROWS hard cap on unwritten rows; beyond it -> 429
BUFFER_MAX_ROWS=500
BUFFER_MAX_LATENCY_MS=200
BUFFER_MAX_PENDING_ROWS=20000
